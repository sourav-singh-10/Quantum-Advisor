{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PortfolioResponse",
  "description": "Successful response of POST /upload_portfolio (HTTP 200). Errors return {error} with HTTP 400.",
  "type": "object",
  "required": [
    "stocks",
    "totalValue",
    "totalCost",
    "totalPnL",
    "totalPnLPct",
    "riskScore",
    "diversificationScore",
    "sectorAllocation",
    "investmentStyle",
    "advice",
    "recommendations",
    "livePriced",
    "review",
    "meta",
    "trace"
  ],
  "properties": {
    "stocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ticker",
          "quantity",
          "buyPrice",
          "currentPrice",
          "pnl",
          "pnlPct",
          "sector",
          "priceSource",
          "volatility",
          "pe",
          "isHighVol"
        ],
        "properties": {
          "ticker": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "buyPrice": {
            "type": "number"
          },
          "currentPrice": {
            "type": "number"
          },
          "pnl": {
            "type": "number"
          },
          "pnlPct": {
            "type": "number"
          },
          "sector": {
            "type": "string"
          },
          "priceSource": {
            "type": "string",
            "description": "'live (<source>)', 'from your file' or 'unavailable (buy price used)'"
          },
          "volatility": {
            "type": [
              "number",
              "null"
            ],
            "description": "Daily volatility %, from live price history"
          },
          "pe": {
            "type": [
              "number",
              "null"
            ]
          },
          "isHighVol": {
            "type": "boolean"
          },
          "weight": {
            "type": "number",
            "description": "% of portfolio value"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Last 60 closes for the sparkline"
          },
          "trend": {
            "type": [
              "string",
              "null"
            ]
          },
          "rsi": {
            "type": [
              "number",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "description": "Why the rule-based call was made"
          }
        }
      }
    },
    "totalValue": {
      "type": "number"
    },
    "totalCost": {
      "type": "number"
    },
    "totalPnL": {
      "type": "number"
    },
    "totalPnLPct": {
      "type": "number"
    },
    "riskScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "diversificationScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "sectorAllocation": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "investmentStyle": {
      "type": "string"
    },
    "advice": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendations": {
      "type": "array"
    },
    "livePriced": {
      "type": "integer",
      "minimum": 0
    },
    "review": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "summary",
        "actions",
        "holdings",
        "degraded"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "holdings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ticker",
              "action",
              "reason"
            ],
            "properties": {
              "action": {
                "enum": [
                  "ADD",
                  "HOLD",
                  "TRIM",
                  "REVIEW"
                ]
              }
            }
          }
        },
        "degraded": {
          "type": "boolean"
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "runId",
        "llmAvailable",
        "llmCalls",
        "llmFailures"
      ]
    },
    "trace": {
      "type": "array",
      "items": {
        "$ref": "trace_event.schema.json"
      }
    },
    "skippedRows": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Rows in the file that were not used, with the reason"
    }
  }
}