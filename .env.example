# Copy to .env (never commit .env) or set these in Render -> Environment.
GEMINI_API_KEY=
# Model ids from your Google AI Studio account. Check with /api/health?deep=1
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-flash

MARKETSTACK_API_KEY=
ALPHAVANTAGE_API_KEY=
NEWS_API_KEY=

# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
REQUIRE_LOGIN=1

# Optional tuning
MAX_DEBATE_ROUNDS=3
MAX_REPLANS=1
MAX_TOOL_STEPS=4
