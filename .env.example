# Copy to .env (never commit .env) or set these in Render -> Environment.
GEMINI_API_KEY=
# Model ids from your Google AI Studio account. Check with /api/health?deep=1
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_MODEL=gemini-3.5-flash
# Optional: tried when the main model is overloaded or retired
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

MARKETSTACK_API_KEY=
ALPHAVANTAGE_API_KEY=
NEWS_API_KEY=

# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
REQUIRE_LOGIN=1
# Optional: a free hosted Postgres (Neon or Supabase) so data survives redeploys.
# Example: postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Optional: "Continue with Google". OAuth client ID (Web application) from Google Cloud Console;
# add http://localhost:5000 and your Render URL as authorised JavaScript origins.
GOOGLE_CLIENT_ID=

# Same facts, same answer (defaults shown). EVAL_FAULTS=1 only on your own machine, for
# `scripts/evaluate.py --scenarios`; never on the public deployment.
LLM_TEMPERATURE=0
LLM_SEED=7
EVAL_FAULTS=0

# Optional tuning
MAX_DEBATE_ROUNDS=3
MAX_REPLANS=1
MAX_TOOL_STEPS=4

# Watchlist briefs: 8:30 morning brief, alerts every 30 min in market hours, 3:15 closing brief.
BRIEF_SCHEDULER=1
# Shared secret for /api/cron/tick (GitHub Actions wakes a sleeping server with it).
CRON_SECRET=
# Public address of the app, used in brief emails.
APP_URL=
# Optional email of briefs. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=a 16-letter app password (Google account -> Security -> App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional phone notifications: create a bot with @BotFather (free).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
